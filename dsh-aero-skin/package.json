{
  "name": "dsh-aero-skin",
  "version": "1.0.0",
  "description": "Windows 7 Aero-inspired glass skin for the DSH Web UI",
  "type": "module",
  "license": "MIT",
  "author": "haitunlang",
  "homepage": "https://github.com/haitunlang/dsh-aero-glass#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/haitunlang/dsh-aero-glass.git",
    "directory": "dsh-aero-skin"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
